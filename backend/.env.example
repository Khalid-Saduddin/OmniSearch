# OmniSearch Backend Environment Configuration Example
# Copy this file to .env for local development

# Application Information
APP_NAME=OmniSearch Backend
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# Server Network Configuration (Always use 127.0.0.1 for local desktop development)
HOST=127.0.0.1
PORT=8000

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Centralized Logging Configuration
LOG_LEVEL=INFO
